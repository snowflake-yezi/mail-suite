server {
  listen 8080;
  server_name _;

  root /usr/share/nginx/html;
  index index.html;

  location /health/ {
    proxy_pass ${MAIL_SUITE_API_UPSTREAM};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Request-ID $request_id;
  }

  location / {
    try_files $uri $uri/ /index.html;
  }
}
